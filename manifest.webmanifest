{
  "name": "Fretline – Guitar Trainer",
  "short_name": "Fretline",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f1115",
  "theme_color": "#0f1115",
  "description": "Guitar trainer with live note recognition and a scrolling note highway.",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "text/*",
            "application/pdf",
            "audio/midi",
            "audio/x-midi",
            "application/xml",
            "text/xml",
            "application/vnd.recordare.musicxml",
            "application/vnd.recordare.musicxml+xml",
            "application/octet-stream",
            ".gp",
            ".gp3",
            ".gp4",
            ".gp5",
            ".gpx",
            ".mid",
            ".midi",
            ".musicxml",
            ".mxl",
            ".xml",
            ".cho",
            ".chordpro",
            ".crd",
            ".pdf",
            ".txt"
          ]
        }
      ]
    }
  }
}
